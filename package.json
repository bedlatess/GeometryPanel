{
  "name": "zeeho-panel-web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/api/*.test.ts src/core/*.test.ts",
    "test:browser": "playwright test",
    "verify": "npm test && npm run build && npm run test:browser",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@ionic/vue": "^9.0.10",
    "@ionic/vue-router": "^9.0.10",
    "@noble/hashes": "1.8.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "^3.3.14"
  }
}
